{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://archemedica.local/schemas/decision-memory-outcome-calibration/v1.0",
  "title":"Archemedica Decision Memory and Outcome Calibration",
  "description":"Tenant-isolated decision-memory and outcome-linkage contract. It does not establish causality, decision correctness, scientific validity, regulatory compliance, or clinical benefit.",
  "type":"object",
  "additionalProperties":false,
  "required":["memory_link_id","schema_version","tenant_id","decision_ref","outcome","relationship","reassessment","provenance"],
  "properties":{
    "memory_link_id":{"type":"string","pattern":"^DMOC-[A-Z0-9_-]+$"},
    "schema_version":{"const":"1.0"},
    "tenant_id":{"type":"string","minLength":1},
    "decision_ref":{"type":"object","additionalProperties":false,"required":["der_ref","decision_timestamp"],"properties":{"der_ref":{"type":"string","minLength":1},"decision_timestamp":{"type":"string","format":"date-time"},"pcdi_ref":{"type":["string","null"]},"rdre_ref":{"type":["string","null"]},"model_use_refs":{"type":"array","items":{"type":"string"}}}},
    "outcome":{"type":"object","additionalProperties":false,"required":["outcome_id","outcome_type","observation_window","status","evidence_refs","data_rights_status"],"properties":{
      "outcome_id":{"type":"string","pattern":"^OUT-[A-Z0-9_-]+$"},
      "outcome_type":{"type":"string","enum":["PROTOCOL_IMPLEMENTATION","SITE_OPERATION","ENROLLMENT_RETENTION","DATA_QUALITY","SAFETY_OPERATIONAL","ENDPOINT_DATA_READINESS","REGULATORY_FEEDBACK","AUDIT_INSPECTION","VENDOR_PERFORMANCE","MODEL_PERFORMANCE","FORECAST_CALIBRATION","DECISION_REWORK","TIMELINE","BUDGET","OTHER"]},
      "observation_window":{"type":"object","required":["start","end"],"properties":{"start":{"type":"string","format":"date-time"},"end":{"type":["string","null"],"format":"date-time"}}},
      "status":{"type":"string","enum":["OBSERVED","PARTIAL","PENDING","UNVERIFIED","SUPERSEDED"]},
      "observed_value_ref":{"type":["string","null"]},
      "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
      "limitations":{"type":"array","items":{"type":"string"}},
      "confounders":{"type":"array","items":{"type":"string"}},
      "data_rights_status":{"type":"string","enum":["AUTHORIZED","RESTRICTED","UNKNOWN","HUMAN_REVIEW_REQUIRED"]}
    }},
    "relationship":{"type":"object","additionalProperties":false,"required":["relationship_status","epistemic_effect","causal_status","rationale"],"properties":{
      "relationship_status":{"type":"string","enum":["TEMPORALLY_AFTER","ASSOCIATED_WITH_DECISION","PLAUSIBLY_INFORMATIVE","DIRECTLY_LINKED_IMPLEMENTATION_OUTCOME","INSUFFICIENT_EVIDENCE"]},
      "epistemic_effect":{"type":"string","enum":["SUPPORTS_ASSUMPTION","CONTRADICTS_ASSUMPTION","LIMITS_PRIOR_BASIS","NO_MATERIAL_EFFECT_IDENTIFIED","HUMAN_JUDGMENT_REQUIRED"]},
      "causal_status":{"type":"string","enum":["CAUSAL_ATTRIBUTION_NOT_ESTABLISHED","CAUSAL_ATTRIBUTION_SUPPORTED_BY_CONTROLLED_METHOD","CAUSALITY_NOT_APPLICABLE","HUMAN_JUDGMENT_REQUIRED"]},
      "rationale":{"type":"string","minLength":1},
      "affected_assumption_refs":{"type":"array","items":{"type":"string"}},
      "eig_refs":{"type":"array","items":{"type":"string"}}
    }},
    "calibration":{"type":["object","null"],"additionalProperties":false,"properties":{
      "eligible":{"type":"boolean"},
      "prediction_ref":{"type":["string","null"]},
      "prediction_frozen_at":{"type":["string","null"],"format":"date-time"},
      "target_definition":{"type":["string","null"]},
      "measurement_method_ref":{"type":["string","null"]},
      "calibration_result_ref":{"type":["string","null"]},
      "not_eligible_reason":{"type":["string","null"]}
    }},
    "reassessment":{"type":"object","additionalProperties":false,"required":["trigger_status","affected_object_refs","human_disposition_required"],"properties":{
      "trigger_status":{"type":"string","enum":["NO_TRIGGER","CANDIDATE_REASSESSMENT","REASSESSMENT_REQUIRED","HUMAN_TRIAGE_REQUIRED"]},
      "affected_object_refs":{"type":"array","items":{"type":"string"}},
      "ddg_analysis_ref":{"type":["string","null"]},
      "human_disposition_required":{"type":"boolean"}
    }},
    "tenant_controls":{"type":"object","additionalProperties":false,"properties":{"cross_tenant_pooling":{"const":false},"cross_tenant_training":{"const":false},"exportable":{"type":"boolean"},"retention_policy_ref":{"type":["string","null"]}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["created_at","created_by","audit_event_ids"],"properties":{"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","minLength":1},"audit_event_ids":{"type":"array","items":{"type":"string"}},"record_hash":{"type":["string","null"]}}}
  }
}