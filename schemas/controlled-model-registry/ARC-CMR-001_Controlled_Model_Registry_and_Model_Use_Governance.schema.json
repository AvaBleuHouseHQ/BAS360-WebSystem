{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://archemedica.local/schemas/controlled-model-registry/v1.0",
  "title":"Archemedica Controlled Model Registry and Model Use Governance",
  "description":"Decision-linked model-use governance contract. Structural validation does not establish model validation, scientific correctness, regulatory compliance, or clinical utility.",
  "type":"object",
  "additionalProperties":false,
  "required":["model_use_id","schema_version","tenant_id","model_version","context_of_use","decision_context","status_axes","authorization","invocation_provenance","review"],
  "properties":{
    "model_use_id":{"type":"string","pattern":"^MUSE-[A-Z0-9_-]+$"},
    "schema_version":{"const":"1.0"},
    "tenant_id":{"type":"string","minLength":1},
    "model_version":{"type":"object","additionalProperties":false,"required":["model_id","model_version_id","model_class","provider","version_identifier","lifecycle_status"],"properties":{
      "model_id":{"type":"string","pattern":"^MODEL-[A-Z0-9_-]+$"},
      "model_version_id":{"type":"string","pattern":"^MODELVER-[A-Z0-9_-]+$"},
      "model_class":{"type":"string","enum":["DETERMINISTIC_RULE","STATISTICAL","MACHINE_LEARNING","GENERATIVE_AI","SIMULATION","DIGITAL_TWIN","HYBRID","OTHER"]},
      "provider":{"type":"string","minLength":1},
      "version_identifier":{"type":"string","minLength":1},
      "artifact_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},
      "implementation_ref":{"type":["string","null"]},
      "lifecycle_status":{"type":"string","enum":["PROPOSED","ACTIVE","RESTRICTED","RETIRED","SUPERSEDED","UNVERIFIED"]},
      "superseded_by":{"type":["string","null"]}
    }},
    "context_of_use":{"type":"object","additionalProperties":false,"required":["cou_id","purpose","population_or_domain","output_meaning","consequence_level","allowed_influence","limitations"],"properties":{
      "cou_id":{"type":"string","pattern":"^COU-[A-Z0-9_-]+$"},
      "purpose":{"type":"string","minLength":1},
      "population_or_domain":{"type":"string","minLength":1},
      "input_requirements":{"type":"array","items":{"type":"string"}},
      "output_meaning":{"type":"string","minLength":1},
      "operating_conditions":{"type":"array","items":{"type":"string"}},
      "exclusions":{"type":"array","items":{"type":"string"}},
      "limitations":{"type":"array","items":{"type":"string"}},
      "consequence_level":{"type":"string","enum":["LOW","MODERATE","HIGH","CRITICAL"]},
      "allowed_influence":{"type":"string","enum":["INFORMATIONAL","ADVISORY","MATERIAL"]},
      "required_human_expertise":{"type":"array","items":{"type":"string"}},
      "validation_evidence_refs":{"type":"array","items":{"type":"string"}}
    }},
    "decision_context":{"type":"object","additionalProperties":false,"required":["decision_ref","requested_influence","actual_influence"],"properties":{
      "decision_ref":{"type":"string","minLength":1},
      "der_ref":{"type":["string","null"]},
      "pcdi_ref":{"type":["string","null"]},
      "rdre_ref":{"type":["string","null"]},
      "requested_influence":{"type":"string","enum":["INFORMATIONAL","ADVISORY","MATERIAL","DETERMINATIVE"]},
      "actual_influence":{"type":"string","enum":["INFORMATIONAL","ADVISORY","MATERIAL","DETERMINATIVE"]}
    }},
    "status_axes":{"type":"object","additionalProperties":false,"required":["implementation","verification","cou_validation","scientific_credibility","regulatory_relevance","security_privacy","data_rights","production_readiness"],"properties":{
      "implementation":{"$ref":"#/$defs/status"},
      "verification":{"$ref":"#/$defs/status"},
      "cou_validation":{"$ref":"#/$defs/status"},
      "scientific_credibility":{"$ref":"#/$defs/status"},
      "regulatory_relevance":{"$ref":"#/$defs/status"},
      "security_privacy":{"$ref":"#/$defs/status"},
      "data_rights":{"$ref":"#/$defs/status"},
      "production_readiness":{"$ref":"#/$defs/status"}
    }},
    "authorization":{"type":"object","additionalProperties":false,"required":["status","blocking_conditions","eig_refs","authorized_by"],"properties":{
      "status":{"type":"string","enum":["AUTHORIZED","AUTHORIZED_WITH_CONDITIONS","NOT_AUTHORIZED","HUMAN_REVIEW_REQUIRED","INSUFFICIENT_EVIDENCE"]},
      "blocking_conditions":{"type":"array","items":{"type":"string"}},
      "conditions":{"type":"array","items":{"type":"string"}},
      "eig_refs":{"type":"array","items":{"type":"string"}},
      "authorized_by":{"type":["string","null"]},
      "authorized_at":{"type":["string","null"],"format":"date-time"}
    }},
    "invocation_provenance":{"type":"object","additionalProperties":false,"required":["invoked_at","configuration_ref","input_refs","output_ref","audit_event_ids"],"properties":{
      "invoked_at":{"type":"string","format":"date-time"},
      "configuration_ref":{"type":"string","minLength":1},
      "parameter_snapshot_ref":{"type":["string","null"]},
      "preprocessing_ref":{"type":["string","null"]},
      "input_refs":{"type":"array","items":{"type":"string"}},
      "output_ref":{"type":"string","minLength":1},
      "output_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},
      "uncertainty_ref":{"type":["string","null"]},
      "audit_event_ids":{"type":"array","items":{"type":"string"}}
    }},
    "review":{"type":"object","additionalProperties":false,"required":["accountable_reviewer","review_status","override_status"],"properties":{
      "accountable_reviewer":{"type":"string","minLength":1},
      "review_status":{"type":"string","enum":["PENDING","ACCEPTED_FOR_USE","ACCEPTED_WITH_LIMITATIONS","REJECTED","ESCALATED"]},
      "override_status":{"type":"string","enum":["NO_OVERRIDE","MODEL_OUTPUT_OVERRIDDEN","AUTHORIZATION_EXCEPTION_REQUESTED","AUTHORIZATION_EXCEPTION_REJECTED"]},
      "override_rationale":{"type":["string","null"]}
    }},
    "reassessment_triggers":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"status":{"type":"string","enum":["NOT_ASSESSED","UNVERIFIED","PARTIAL","ACCEPTABLE_FOR_COU","NOT_ACCEPTABLE_FOR_COU","RESTRICTED","SUPERSEDED","NOT_APPLICABLE","HUMAN_REVIEW_REQUIRED"]}}
}