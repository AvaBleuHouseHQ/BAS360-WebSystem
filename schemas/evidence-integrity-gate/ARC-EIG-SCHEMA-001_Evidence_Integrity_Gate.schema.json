{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archemedica.local/schemas/evidence-integrity-gate/v1.0",
  "title": "Archemedica Evidence Integrity Gate",
  "description": "Structured assessment of whether a claim is traceably supportable by cited evidence under a defined context. It does not determine scientific truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eig_id","schema_version","tenant_id","claim","context","evidence_links","assessment","disposition","review","provenance"],
  "properties": {
    "eig_id": {"type":"string","pattern":"^EIG-[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "schema_version": {"const":"1.0"},
    "tenant_id": {"type":"string","minLength":1},
    "claim": {"type":"object","additionalProperties":false,"required":["claim_id","claim_text","claim_type","materiality"],"properties":{"claim_id":{"type":"string","pattern":"^CLM-[A-Z0-9_-]+$"},"claim_text":{"type":"string","minLength":3},"claim_type":{"type":"string","enum":["FACTUAL","SCIENTIFIC","REGULATORY","MODEL_OUTPUT","INFERENCE","OPERATIONAL","SECURITY","DATA_RIGHTS","MARKET","OTHER"]},"materiality":{"type":"string","enum":["LOW","MODERATE","HIGH","CRITICAL"]},"source_artifact_ref":{"type":["string","null"]},"author_or_origin":{"type":["string","null"]}}},
    "context": {"type":"object","additionalProperties":false,"required":["intended_use"],"properties":{"intended_use":{"type":"string","minLength":3},"decision_ref":{"type":["string","null"]},"model_context_of_use":{"type":["string","null"]},"population_or_scope":{"type":["string","null"]},"jurisdiction":{"type":["string","null"]},"effective_date":{"type":["string","null"],"format":"date"},"out_of_scope":{"type":"array","items":{"type":"string"}}}},
    "evidence_links": {"type":"object","additionalProperties":false,"required":["supporting","contradicting","limiting"],"properties":{"supporting":{"type":"array","items":{"$ref":"#/$defs/evidence_link"}},"contradicting":{"type":"array","items":{"$ref":"#/$defs/evidence_link"}},"limiting":{"type":"array","items":{"$ref":"#/$defs/evidence_link"}}}},
    "assessment": {"type":"object","additionalProperties":false,"required":["traceability","source_quality","claim_evidence_alignment","context_fit","conflict_status","staleness_status","epistemic_status","reasoning_summary"],"properties":{"traceability":{"type":"string","enum":["COMPLETE","PARTIAL","BROKEN"]},"source_quality":{"type":"string","enum":["PRIMARY_AUTHORITATIVE","PRIMARY_OTHER","SECONDARY_HIGH","SECONDARY_OTHER","UNVERIFIED","MIXED"]},"claim_evidence_alignment":{"type":"string","enum":["DIRECT","INDIRECT","WEAK","NONE","OVERSTATED"]},"context_fit":{"type":"string","enum":["IN_CONTEXT","PARTIAL_CONTEXT","OUTSIDE_CONTEXT","NOT_APPLICABLE","UNKNOWN"]},"conflict_status":{"type":"string","enum":["NONE_IDENTIFIED","RESOLVED","UNRESOLVED","MATERIAL_CONFLICT"]},"staleness_status":{"type":"string","enum":["CURRENT","POTENTIALLY_STALE","STALE","SUPERSEDED","UNKNOWN"]},"epistemic_status":{"type":"string","enum":["SUPPORTED","PARTIALLY_SUPPORTED","CONFLICTED","INFERRED","UNSUPPORTED","STALE","SUPERSEDED","OUTSIDE_CONTEXT_OF_USE","HUMAN_JUDGMENT_REQUIRED"]},"reasoning_summary":{"type":"string","minLength":10},"limitations":{"type":"array","items":{"type":"string"}},"missing_evidence":{"type":"array","items":{"type":"string"}}}},
    "automated_checks": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["check_id","check_type","result","method_version"],"properties":{"check_id":{"type":"string","pattern":"^CHK-[A-Z0-9_-]+$"},"check_type":{"type":"string","enum":["CITATION_RESOLUTION","HASH_MATCH","VERSION_MATCH","DATE_STALENESS","SOURCE_AUTHORITY","CLAIM_TEXT_MATCH","ENTAILMENT_SCREEN","CONTRADICTION_SCREEN","DUPLICATE_SOURCE","PROVENANCE_CHAIN","CONTEXT_BOUNDARY","OTHER"]},"result":{"type":"string","enum":["PASS","FAIL","WARN","NOT_RUN","INDETERMINATE"]},"method_version":{"type":"string","minLength":1},"details":{"type":["string","null"]},"output_ref":{"type":["string","null"]}}}},
    "disposition": {"type":"object","additionalProperties":false,"required":["gate_status","allowed_uses"],"properties":{"gate_status":{"type":"string","enum":["PASS","PASS_WITH_LIMITATIONS","HOLD_FOR_HUMAN_REVIEW","FAIL_UNSUPPORTED","FAIL_CONFLICTED","FAIL_STALE","FAIL_OUTSIDE_CONTEXT","FAIL_BROKEN_PROVENANCE"]},"allowed_uses":{"type":"array","items":{"type":"string"}},"prohibited_uses":{"type":"array","items":{"type":"string"}},"required_actions":{"type":"array","items":{"type":"string"}}}},
    "review": {"type":"object","additionalProperties":false,"required":["human_review_required","review_status"],"properties":{"human_review_required":{"type":"boolean"},"review_status":{"type":"string","enum":["NOT_REQUIRED","PENDING","COMPLETED","REJECTED","ESCALATED"]},"reviewer":{"type":["string","null"]},"reviewed_at":{"type":["string","null"],"format":"date-time"},"review_rationale":{"type":["string","null"]}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["created_at","created_by","audit_event_ids"],"properties":{"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","minLength":1},"input_snapshot_refs":{"type":"array","items":{"type":"string"}},"audit_event_ids":{"type":"array","items":{"type":"string"}},"record_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"}}}
  },
  "$defs": {"evidence_link":{"type":"object","additionalProperties":false,"required":["evidence_id","relationship"],"properties":{"evidence_id":{"type":"string","pattern":"^EVID-[A-Z]+-[0-9]{4}$"},"relationship":{"type":"string","enum":["SUPPORTS","CONTRADICTS","LIMITS"]},"version_or_hash":{"type":["string","null"]},"relevance_note":{"type":["string","null"]}}}}
}