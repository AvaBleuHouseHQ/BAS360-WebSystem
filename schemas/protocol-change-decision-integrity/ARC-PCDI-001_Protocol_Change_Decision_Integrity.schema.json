{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archemedica Protocol Change Decision Integrity",
  "type": "object",
  "additionalProperties": false,
  "required": ["pcdi_id","schema_version","tenant_id","study_context","protocol_versions","change_set","impact_assessment","decision_packet","implementation","review","provenance"],
  "properties": {
    "pcdi_id": {"type":"string","pattern":"^PCDI-[A-Z0-9_-]+$"},
    "schema_version": {"const":"1.0"},
    "tenant_id": {"type":"string","minLength":1},
    "study_context": {"type":"object","required":["study_id","jurisdictions"],"properties":{"study_id":{"type":"string"},"program_id":{"type":["string","null"]},"jurisdictions":{"type":"array","minItems":1,"items":{"type":"string"}},"development_phase":{"type":["string","null"]}}},
    "protocol_versions": {"type":"object","required":["from_version","to_version","from_artifact_ref","to_artifact_ref"],"properties":{"from_version":{"type":"string"},"to_version":{"type":"string"},"from_artifact_ref":{"type":"string"},"to_artifact_ref":{"type":"string"},"from_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},"to_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"}}},
    "change_set": {"type":"array","minItems":1,"items":{"type":"object","required":["change_id","change_type","location","materiality_screen","status"],"properties":{"change_id":{"type":"string"},"change_type":{"type":"string","enum":["ADMINISTRATIVE","ELIGIBILITY","INTERVENTION","DOSE_OR_EXPOSURE","SAFETY_MONITORING","ENDPOINT","STATISTICAL","SAMPLE_SIZE","VISIT_SCHEDULE","PROCEDURE","CONTROL_ARM","RANDOMIZATION","BLINDING","DATA_COLLECTION","BIOSPECIMEN","INFORMED_CONSENT","INVESTIGATOR_SITE","OPERATIONAL","REGULATORY","OTHER"]},"location":{"type":"string"},"before":{"type":["string","null"]},"after":{"type":["string","null"]},"materiality_screen":{"type":"string","enum":["MINOR","POTENTIALLY_MATERIAL","MATERIAL","CRITICAL","UNDETERMINED"]},"status":{"type":"string","enum":["PROPOSED","CONFIRMED","REJECTED_AS_CHANGE","SUPERSEDED"]}}}},
    "impact_assessment": {"type":"object","required":["dimensions","ddg_impact","unresolved_items"],"properties":{"dimensions":{"type":"array","items":{"type":"object","required":["dimension","impact_status","rationale"],"properties":{"dimension":{"type":"string"},"impact_status":{"type":"string","enum":["NONE_IDENTIFIED","POSSIBLE","CONFIRMED","CRITICAL","NOT_ASSESSED"]},"rationale":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},"ddg_impact":{"type":"object","required":["analysis_ref","affected_decision_refs","affected_assumption_refs"],"properties":{"analysis_ref":{"type":"string"},"affected_decision_refs":{"type":"array","items":{"type":"string"}},"affected_assumption_refs":{"type":"array","items":{"type":"string"}},"affected_artifact_refs":{"type":"array","items":{"type":"string"}}}},"unresolved_items":{"type":"array","items":{"type":"object","required":["item_id","description","owner","blocking"],"properties":{"item_id":{"type":"string"},"description":{"type":"string"},"owner":{"type":"string"},"blocking":{"type":"boolean"}}}}}},
    "decision_packet": {"type":"object","required":["der_ref","decision_status","selected_action","accountable_owner"],"properties":{"der_ref":{"type":"string"},"decision_status":{"type":"string","enum":["APPROVED","APPROVED_WITH_CONDITIONS","REJECTED","DEFERRED","INSUFFICIENT_EVIDENCE","WITHDRAWN"]},"selected_action":{"type":"string","enum":["IMPLEMENT_STANDARD_PATH","IMPLEMENT_IMMEDIATE_HAZARD_PATH","REVISE_AND_REASSESS","DO_NOT_IMPLEMENT","DEFER_PENDING_EVIDENCE"]},"accountable_owner":{"type":"string"},"decision_rationale":{"type":["string","null"]}}},
    "implementation": {"type":"object","required":["pathway","readiness_status","required_actions"],"properties":{"pathway":{"type":"string","enum":["STANDARD","IMMEDIATE_HAZARD","NOT_IMPLEMENTED"]},"readiness_status":{"type":"string","enum":["NOT_READY","CONDITIONALLY_READY","READY","IMPLEMENTED","BLOCKED"]},"required_actions":{"type":"array","items":{"type":"object","required":["action_id","action_type","owner","status"],"properties":{"action_id":{"type":"string"},"action_type":{"type":"string"},"owner":{"type":"string"},"status":{"type":"string","enum":["NOT_STARTED","IN_PROGRESS","BLOCKED","COMPLETE","NOT_APPLICABLE"]},"evidence_of_completion_ref":{"type":["string","null"]}}}},"immediate_hazard_rationale":{"type":["string","null"]}}},
    "review": {"type":"object","required":["required_roles","completed_roles","qc_status"],"properties":{"required_roles":{"type":"array","items":{"type":"string"}},"completed_roles":{"type":"array","items":{"type":"string"}},"qc_status":{"type":"string","enum":["PENDING","PASS","PASS_WITH_CONDITIONS","FAIL"]}}},
    "provenance": {"type":"object","required":["created_at","created_by","audit_event_ids"],"properties":{"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string"},"audit_event_ids":{"type":"array","items":{"type":"string"}},"record_hash":{"type":["string","null"]}}}
  }
}